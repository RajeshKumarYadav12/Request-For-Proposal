# Backend
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/ai_rfp_manager

# Email (sending)
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-smtp-user
EMAIL_SMTP_PASS=your-smtp-pass
EMAIL_FROM="RFP Manager <no-reply@example.com>"

# Email (receiving - IMAP)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=your-imap-user
IMAP_PASS=your-imap-pass

# AI provider
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional
LOG_LEVEL=info
